[Unit]
Description=HostPanel WireGuard VPN (wg0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'PATH=/opt/hostpanel/plugins/wireguard:$PATH /opt/hostpanel/plugins/wireguard/wg-quick up /opt/hostpanel/plugins/wireguard/wg0.conf'
ExecStop=/bin/sh -c 'PATH=/opt/hostpanel/plugins/wireguard:$PATH /opt/hostpanel/plugins/wireguard/wg-quick down /opt/hostpanel/plugins/wireguard/wg0.conf'
ExecReload=/bin/sh -c 'PATH=/opt/hostpanel/plugins/wireguard:$PATH /opt/hostpanel/plugins/wireguard/wg syncconf wg0 /opt/hostpanel/plugins/wireguard/wg0.conf'

[Install]
WantedBy=multi-user.target
